* text=auto
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.pdf binary

# Preserve historical snapshot bytes exactly so MANIFEST.sha256 remains portable.
reference/** -text

# The pinned upstream license is also covered by Unity's byte checksums.
test/host/unity/LICENSE.txt -text
