# Overlay defaults + communication + led-bringup + led-short-bench, then this.
CONFIG_NN2_OPTICAL_ACQUISITION=y
CONFIG_NN2_LED_RUNTIME_I2C_HZ=800000
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions/acquisition-16mb.csv"

# Acquisition CPU budget; SPI remains 8 MHz, LED runtime I2C remains 800 kHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# ADC ISR call graph and SPI transport placement (ESP-IDF 6.1).
CONFIG_ESP_TIMER_IN_IRAM=y
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_SPI_MASTER_IN_IRAM=y

# First prove the complete V4-derived ADC path without LED setup/runtime.
CONFIG_NN2_ADC_V4_DARK_BASELINE=y
