# Explicit Nocti board v1 / N16R8 emitter-inactive diagnostic build overlay.
CONFIG_NN2_PROFILE_ADS131_DIAGNOSTIC=y
# CONFIG_NN2_PROFILE_FAKE is not set
# CONFIG_SPIRAM is not set
# CONFIG_SPIRAM_MODE_OCT is not set
# CONFIG_ESPTOOLPY_OCT_FLASH is not set
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y

# ADC ISR call graph and SPI transport placement (ESP-IDF 6.1).
CONFIG_ESP_TIMER_IN_IRAM=y
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_SPI_MASTER_IN_IRAM=y
