menu "NoctiNIRS 2 v0.1.0"

    choice NN2_PROFILE
        prompt "Firmware profile"
        default NN2_PROFILE_FAKE
        config NN2_PROFILE_COMMUNICATION
            bool "Communication Foundation / emitter reset held low"
            help
                SoftAP-only, NVS boot identity, USB diagnostics and UDP request/reply.
                LED/ADC commands are simulated; RESET_LED remains asserted.
                Use sdkconfig.communication for the required main task stack.
        config NN2_PROFILE_FAKE
            bool "Fake ADC / disabled emitter baseline"
        config NN2_PROFILE_ADS131_DIAGNOSTIC
            bool "ADS131 diagnostic / emitter energy unavailable fixture required"
    endchoice

    config NN2_UDP_PORT
        int "Communication Foundation UDP control port"
        range 1024 65535
        default 3333

    config NN2_LED_BRINGUP
        bool "Enable real LED-only bring-up commands (requires reviewed bench procedure)"
        depends on NN2_PROFILE_COMMUNICATION
        default n
        select GPIO_CTRL_FUNC_IN_IRAM
        select GPTIMER_ISR_CACHE_SAFE
        select GPTIMER_CTRL_FUNC_IN_IRAM
        select I2C_ISR_IRAM_SAFE
        help
            Real PCA9956B drive on explicit START, 20 optical slots, one channel
            at a time. Boot remains OFF. Default Fs=5 Hz and current=30 mA.
            No ADC/frames. Physical energization requires Owner authorization.

    config NN2_LED_SHORT_BENCH
        bool "Board-specific SHORT advisory engineering candidate (unqualified)"
        depends on NN2_LED_BRINGUP
        default n
        help
            Same assembled board only, Fs2..10Hz, twenty nominal 30 mA slots.
            Host-selected duration, repeat START after completed STOP/cleanup.
            No firmware duration ceiling; lease timeout and hard faults remain.
            Can mask a real short. Requires specialist review before activation.

    config NN2_LED_RUNTIME_I2C_HZ
        int "LED async runtime SCL (800kHz is an experimental board setting)"
        depends on NN2_LED_BRINGUP
        range 100000 800000
        default 400000
        help
            Boot/configuration uses synchronous100kHz. Only the exclusive LED
            scan owner uses this async runtime rate. ESP32-S3 documentation
            specifies400kHz maximum; the Owner-selected800kHz V4-style setting
            is experimental and is not an SDK/electrical qualification.

    config NN2_LED_SETTLE_US
        int "Settle wait between (disabled) LED on and (fake) sample (us)"
        range 0 1000
        default 100
        help
            Short bounded busy-wait (esp_rom_delay_us) in the sequencer task.
            Capped at 1 ms; any longer wait must become a blocking RTOS delay
            (pending Agent 05 / RTOS review, #12).

    config NN2_DEMO_CYCLES
        int "Number of acquisition cycles to run at boot"
        range 1 1000
        default 5

endmenu
