+++ new/software/paired-frame.js	2026-07-17 05:06:13.771208341 +0000
@@ -0,0 +1,211 @@
+// ============================================================
+// File: paired-frame.js
+// Strict assembly of NoctiNIRS paired LED-ON / LED-OFF phase records.
+// A corrected optical frame is emitted only when both phase records with the
+// same UDP session and frame_id are present. Missing phases are never replaced
+// with a previous frame, which prevents silent stale-dark subtraction.
+// ============================================================
+
+const SLOT_COUNT = 20;
+const SLOT_MASK = 0x000fffff;
+
+function popcount32(value) {
+  let v = value >>> 0;
+  let count = 0;
+  while (v !== 0) {
+    v &= v - 1;
+    count += 1;
+  }
+  return count;
+}
+
+function finiteAverages(slot) {
+  return Array.isArray(slot?.averages)
+    && slot.averages.length >= 4
+    && slot.averages.slice(0, 4).every((value) => Number.isFinite(Number(value)));
+}
+
+function phaseSlotValid(slot, requiredK) {
+  const nUsed = Number(slot?.nUsed);
+  const countIsValid = Number.isInteger(nUsed)
+    && nUsed > 0
+    && (requiredK === null || nUsed === requiredK);
+  return Boolean(slot)
+    && slot.valid !== false
+    && slot.underK !== true
+    && slot.crcDropped !== true
+    && countIsValid
+    && finiteAverages(slot);
+}
+
+export function buildPairedFrame(ledOnFrame, ledOffFrame, {
+  kOn = null,
+  kOff = null,
+} = {}) {
+  if (!ledOnFrame || !ledOffFrame) throw new TypeError("Both LED-ON and LED-OFF frames are required");
+  if (ledOnFrame.frameId !== ledOffFrame.frameId) throw new RangeError("Phase frame_id mismatch");
+  if (ledOnFrame.phase !== "led_on" || ledOffFrame.phase !== "led_off") {
+    throw new RangeError("Invalid LED phase ordering");
+  }
+  if (!Array.isArray(ledOnFrame.slots) || !Array.isArray(ledOffFrame.slots)) {
+    throw new TypeError("Both phase records must contain slots");
+  }
+
+  const requiredOn = Number.isInteger(Number(kOn)) && Number(kOn) > 0 ? Number(kOn) : null;
+  const requiredOff = Number.isInteger(Number(kOff)) && Number(kOff) > 0 ? Number(kOff) : null;
+  const slots = [];
+  let validMask = 0;
+  let underKMask = 0;
+  let crcMask = 0;
+  let underKOnSlotCount = 0;
+  let underKOffSlotCount = 0;
+
+  for (let slotIndex = 0; slotIndex < SLOT_COUNT; slotIndex += 1) {
+    const onSlot = ledOnFrame.slots[slotIndex];
+    const offSlot = ledOffFrame.slots[slotIndex];
+    const bit = 1 << slotIndex;
+
+    const onCount = Number(onSlot?.nUsed ?? 0);
+    const offCount = Number(offSlot?.nUsed ?? 0);
+    const underKOn = !onSlot
+      || onCount <= 0
+      || (requiredOn !== null && onCount !== requiredOn)
+      || onSlot?.underK === true;
+    const underKOff = !offSlot
+      || offCount <= 0
+      || (requiredOff !== null && offCount !== requiredOff)
+      || offSlot?.underK === true;
+    const unbalancedCount = onCount !== offCount;
+    const underK = underKOn || underKOff || unbalancedCount;
+    const crcDropped = onSlot?.crcDropped === true || offSlot?.crcDropped === true;
+    const valid = !unbalancedCount
+      && phaseSlotValid(onSlot, requiredOn)
+      && phaseSlotValid(offSlot, requiredOff);
+
+    const ledOnAverages = finiteAverages(onSlot)
+      ? onSlot.averages.slice(0, 4).map(Number)
+      : [null, null, null, null];
+    const ledOffAverages = finiteAverages(offSlot)
+      ? offSlot.averages.slice(0, 4).map(Number)
+      : [null, null, null, null];
+    const averages = ledOnAverages.map((value, pd) => (
+      Number.isFinite(value) && Number.isFinite(ledOffAverages[pd])
+        ? value - ledOffAverages[pd]
+        : null
+    ));
+
+    if (valid) validMask |= bit;
+    if (underK) underKMask |= bit;
+    if (underKOn) underKOnSlotCount += 1;
+    if (underKOff) underKOffSlotCount += 1;
+    if (crcDropped) crcMask |= bit;
+
+    slots.push({
