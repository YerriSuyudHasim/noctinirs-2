{
    "cmake.configureOnOpen": false,
    "cmake.options.statusBarVisibility": "hidden",
    "cmake.options.advanced": {
        "build": { "statusBarVisibility": "hidden" }
    },
    "idf.currentSetup": "C:\\esp\\v6.1\\esp-idf",
    "idf.openOcdConfigs": [
        "board/esp32s3-builtin.cfg"
    ],
    "idf.customExtraVars": {
        "IDF_PY_BUILD_JOBS": "3"
    },
    "idf.ninjaArgs": ["-j", "3"],
    "clangd.path": "C:\\Espressif\\tools\\esp-clangd\\esp-21.1.3_20260408\\esp-clangd\\bin\\clangd.exe",
    "clangd.arguments": [
        "--background-index",
        "--query-driver=**",
        "--compile-commands-dir=${workspaceFolder}/build/led-bringup"
    ],
    "idf.flashType": "UART",
    "idf.port": "COM11",
    "idf.cmakeCompilerArgs": [
        "-G",
        "Ninja",
        "-DPYTHON_DEPS_CHECKED=1",
        "-DESP_PLATFORM=1",
        "-DNN2_USE_BRANCH_PROFILE=ON"
    ],
    "idf.buildPath": "${workspaceFolder}/build/led-bringup",
    "idf.sdkconfigFilePath": "${workspaceFolder}/build/profile-configs/led-bringup/sdkconfig",
    "idf.sdkconfigDefaults": [
        "sdkconfig.defaults",
        "sdkconfig.communication",
        "sdkconfig.led-bringup",
        "sdkconfig.led-short-bench"
    ]
}
