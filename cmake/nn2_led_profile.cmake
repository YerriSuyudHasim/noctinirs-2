include_guard(GLOBAL)
# Optional owner-selected board policy assertion; no default policy override.
function(nn2_check_led_profile expected communication led advisory)
    if(NOT expected STREQUAL "STRICT" AND NOT expected STREQUAL "BENCH_WARN")
        message(FATAL_ERROR "Unknown NN2_EXPECT_LED_POLICY=${expected}; choose STRICT or BENCH_WARN")
    endif()
    if(NOT communication OR NOT led)
        message(FATAL_ERROR "Selected LED board profile requires communication and real LED bring-up")
    endif()
    if(advisory)
        set(actual "BENCH_WARN")
    else()
        set(actual "STRICT")
    endif()
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR
            "LED profile mismatch: expected=${expected}, generated=${actual}. Existing sdkconfig overrides defaults. Run tools/nn2_board_profile.py select for the intended profile before the Owner build; do not flash this configuration.")
    endif()
    if(advisory)
        message(STATUS "NN2 board policy=BENCH_WARN; Fs2..10Hz; 30mA; duration=HOST; limit_s=0; single_run=0; physical qualification pending")
    else()
        message(STATUS "NN2 board policy=STRICT; SHORT/ERROR remains fatal")
    endif()
endfunction()

function(nn2_check_led_transport expected actual led iram)
    if(NOT led OR NOT iram OR NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "LED runtime clock/IRAM mismatch; select the intended board profile before the Owner build")
    endif()
    message(STATUS "NN2 LED transport=ASYNC; runtime SCL=${actual}; boot SCL=100000")
endfunction()
