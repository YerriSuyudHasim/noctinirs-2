include_guard(GLOBAL)
# Explicit CI/diagnostic builds keep their existing SDKCONFIG_DEFAULTS behavior.
# VS Code opts into the branch profile through its versioned settings.
option(NN2_USE_BRANCH_PROFILE "Use this branch's versioned development build profile" OFF)

macro(nn2_prepare_branch_profile)
    if(NN2_USE_BRANCH_PROFILE)
        include("${CMAKE_SOURCE_DIR}/config/active-build-profile.cmake")
        if(NOT NN2_BRANCH_PROFILE MATCHES "^[a-z][a-z0-9-]+$")
            message(FATAL_ERROR "Invalid branch build profile identifier")
        endif()
        if(DEFINED IDF_TARGET AND NOT IDF_TARGET STREQUAL "esp32s3")
            message(FATAL_ERROR "Branch profile requires ESP32-S3; use a separate build directory")
        endif()
        set(IDF_TARGET esp32s3 CACHE STRING "Branch profile target" FORCE)
        set(_nn2_defaults "")
        foreach(_nn2_overlay IN LISTS NN2_BRANCH_DEFAULTS)
            if(NOT EXISTS "${CMAKE_SOURCE_DIR}/${_nn2_overlay}")
                message(FATAL_ERROR "Missing branch overlay: ${_nn2_overlay}")
            endif()
            list(APPEND _nn2_defaults "${CMAKE_SOURCE_DIR}/${_nn2_overlay}")
        endforeach()
        # Root sdkconfig and other profiles' caches remain untouched. This path
        # also changes when a future branch changes its profile identifier.
        set(SDKCONFIG "${CMAKE_SOURCE_DIR}/build/profile-configs/${NN2_BRANCH_PROFILE}/sdkconfig"
            CACHE FILEPATH "Generated branch profile configuration" FORCE)
        get_filename_component(_nn2_config_dir "${SDKCONFIG}" DIRECTORY)
        file(MAKE_DIRECTORY "${_nn2_config_dir}")
        set(SDKCONFIG_DEFAULTS "${_nn2_defaults}" CACHE STRING "Branch profile overlays" FORCE)
        message(STATUS "NN2 branch profile=${NN2_BRANCH_PROFILE}; sdkconfig=${SDKCONFIG}")
    endif()
endmacro()

function(nn2_validate_branch_profile)
    if(NOT NN2_USE_BRANCH_PROFILE)
        return()
    endif()
    foreach(key IN LISTS NN2_BRANCH_REQUIRED_ON)
        if(NOT CONFIG_${key})
            message(FATAL_ERROR "Branch profile ${NN2_BRANCH_PROFILE} requires CONFIG_${key}=y. Existing profile sdkconfig overrides defaults; correct this key in menuconfig or back up and regenerate ${SDKCONFIG}.")
        endif()
    endforeach()
    foreach(key IN LISTS NN2_BRANCH_REQUIRED_OFF)
        if(CONFIG_${key})
            message(FATAL_ERROR "Branch profile ${NN2_BRANCH_PROFILE} requires CONFIG_${key} disabled")
        endif()
    endforeach()
    if(NOT "${CONFIG_NN2_LED_RUNTIME_I2C_HZ}" STREQUAL "${NN2_BRANCH_LED_I2C_HZ}")
        message(FATAL_ERROR "Branch profile LED runtime clock mismatch: expected ${NN2_BRANCH_LED_I2C_HZ}")
    endif()
    if(NN2_BRANCH_PROFILE STREQUAL "ads131-acquisition" AND
       NOT "${CONFIG_PARTITION_TABLE_CUSTOM_FILENAME}" STREQUAL "config/partitions/acquisition-16mb.csv")
        message(FATAL_ERROR "Acquisition requires the versioned 16 MiB partition table")
    endif()
    message(STATUS "NN2 branch profile validated: ${NN2_BRANCH_PROFILE}")
endfunction()
